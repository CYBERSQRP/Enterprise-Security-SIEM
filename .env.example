# Environment Configuration for SIEM Platform
# Copy this file to .env and update with your values

# ====================================
# General Configuration
# ====================================
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=false

# ====================================
# Kafka Configuration
# ====================================
KAFKA_BROKERS=kafka:9092
KAFKA_REPLICATION_FACTOR=1
KAFKA_NUM_PARTITIONS=10
KAFKA_RETENTION_MS=604800000  # 7 days
KAFKA_COMPRESSION_TYPE=lz4

# Kafka Topics
KAFKA_TOPIC_RAW_EVENTS=raw-events
KAFKA_TOPIC_NORMALIZED_EVENTS=normalized-events
KAFKA_TOPIC_ENRICHED_EVENTS=enriched-events
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_INCIDENTS=incidents

# ====================================
# Elasticsearch Configuration
# ====================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX_PREFIX=siem
ELASTICSEARCH_SHARDS=3
ELASTICSEARCH_REPLICAS=2
ELASTICSEARCH_BULK_SIZE=1000
ELASTICSEARCH_FLUSH_INTERVAL=5s

# ====================================
# PostgreSQL Configuration
# ====================================
POSTGRESQL_HOST=postgresql
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=siem
POSTGRESQL_USER=siem_user
POSTGRESQL_PASSWORD=siem_password_change_me
POSTGRESQL_SSL_MODE=disable
POSTGRESQL_MAX_CONNECTIONS=100

# ====================================
# Redis Configuration
# ====================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10

# ====================================
# InfluxDB Configuration
# ====================================
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=siem-admin-token-change-me
INFLUXDB_ORG=siem
INFLUXDB_BUCKET=metrics

# ====================================
# MinIO/S3 Configuration
# ====================================
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me
S3_BUCKET_COLD_STORAGE=siem-cold-storage
S3_BUCKET_BACKUPS=siem-backups
S3_REGION=us-east-1
S3_USE_SSL=false

# ====================================
# Authentication & Security
# ====================================
JWT_SECRET=change_me_to_random_secret_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h  # 7 days

# Session Configuration
SESSION_SECRET=change_me_to_random_secret_in_production
SESSION_DURATION=86400  # 24 hours

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ====================================
# SAML/SSO Configuration (Optional)
# ====================================
SAML_ENABLED=false
SAML_ENTITY_ID=https://siem.example.com
SAML_SSO_URL=https://idp.example.com/sso
SAML_CERTIFICATE_PATH=/etc/siem/saml/idp-cert.pem

# ====================================
# API Gateway Configuration
# ====================================
API_GATEWAY_PORT=8080
API_GATEWAY_HOST=0.0.0.0
API_RATE_LIMIT_PER_MINUTE=1000
API_TIMEOUT_SECONDS=30
API_CORS_ORIGINS=http://localhost:3000,https://siem.example.com

# ====================================
# Collector Service Configuration
# ====================================
COLLECTOR_SYSLOG_TCP_PORT=514
COLLECTOR_SYSLOG_UDP_PORT=514
COLLECTOR_HTTP_PORT=5140
COLLECTOR_BUFFER_SIZE=10000
COLLECTOR_FLUSH_INTERVAL=5s

# ====================================
# Correlation Engine Configuration
# ====================================
CORRELATION_WINDOW_SIZE=5m
CORRELATION_MAX_EVENTS=10000
CORRELATION_WORKERS=10
CORRELATION_RULE_PATH=/etc/siem/rules/correlation

# ====================================
# Threat Intelligence Configuration
# ====================================
THREAT_INTEL_ENABLED=true
THREAT_INTEL_UPDATE_INTERVAL=1h

# AlienVault OTX
ALIENVAULT_API_KEY=your_api_key_here
ALIENVAULT_ENABLED=true

# VirusTotal
VIRUSTOTAL_API_KEY=your_api_key_here
VIRUSTOTAL_ENABLED=false

# AbuseIPDB
ABUSEIPDB_API_KEY=your_api_key_here
ABUSEIPDB_ENABLED=false

# ====================================
# Alert Manager Configuration
# ====================================
ALERT_RETENTION_DAYS=90
ALERT_DEDUPLICATION_WINDOW=5m

# Notification Channels
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=alerts@example.com
EMAIL_SMTP_PASSWORD=email_password
EMAIL_FROM=siem-alerts@example.com

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

PAGERDUTY_ENABLED=false
PAGERDUTY_API_KEY=your_pagerduty_api_key

# ====================================
# ML/Analytics Configuration
# ====================================
ML_ENABLED=true
ML_MODEL_PATH=/models
ML_TRAINING_INTERVAL=24h
ML_INFERENCE_BATCH_SIZE=1000

# ====================================
# Data Retention Configuration
# ====================================
RETENTION_HOT_DAYS=30
RETENTION_WARM_DAYS=90
RETENTION_COLD_DAYS=2555  # 7 years

# ====================================
# Monitoring Configuration
# ====================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_ENABLED=true
METRICS_INTERVAL=15s

TRACING_ENABLED=true
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# ====================================
# Feature Flags
# ====================================
FEATURE_USER_BEHAVIOR_ANALYTICS=true
FEATURE_THREAT_HUNTING=true
FEATURE_PLAYBOOK_AUTOMATION=true
FEATURE_ML_ANOMALY_DETECTION=true
FEATURE_MULTI_TENANCY=false

# ====================================
# Performance Tuning
# ====================================
WORKER_POOL_SIZE=10
BATCH_PROCESSING_SIZE=1000
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_REQUESTS=1000

# ====================================
# Development/Debug Settings
# ====================================
DEV_MODE=true
PROFILE_ENABLED=false
PPROF_PORT=6060
